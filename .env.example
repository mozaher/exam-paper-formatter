# Copy to .env and adjust. All are optional in local dev (sensible defaults apply).

# Turn DEBUG off in production (enables HTTPS hardening).
DJANGO_DEBUG=1

# REQUIRED in production: a long random string.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-insecure-key-do-not-use-in-production

# Comma-separated hostnames the app will serve (production).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated https origins for CSRF (production), e.g. https://exams.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database. Omit for local SQLite. In production, a Postgres URL:
#   DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_URL=

# Billing: 1 lets org admins self-switch plans (demo). 0 disables self-serve.
BILLING_SELF_SERVE=1
